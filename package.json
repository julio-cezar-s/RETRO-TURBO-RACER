{
  "name": "retro-turbo-racer",
  "version": "4.0.0",
  "private": true,
  "description": "Retro Turbo Racer — jogo de corrida arcade em HTML/CSS/JS (Canvas 2D).",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "simular-powerups": "node tests/ferramentas/simular-powerups.js",
    "verificar-layout": "python3 tests/ferramentas/verificar-layout-no-navegador.py",
    "verificar-idiomas": "python3 tests/ferramentas/verificar-idiomas-no-navegador.py",
    "verificar-recompensas": "python3 tests/ferramentas/verificar-recompensas-no-navegador.py",
    "verificar-vista-ampla": "python3 tests/ferramentas/verificar-vista-ampla-no-navegador.py",
    "android:preparar": "node scripts/preparar-web.js",
    "android:adicionar": "npm run android:preparar && cap add android && node scripts/configurar-android.js",
    "android:sync": "npm run android:preparar && cap sync android",
    "android:abrir": "cap open android",
    "android:executar": "npm run android:sync && cap run android",
    "verificar-android": "python3 tests/ferramentas/verificar-android-no-navegador.py",
    "envio:planejar": "node scripts/envio-github.js",
    "envio:montar": "node scripts/envio-github.js --montar envio-github"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
